<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MSFSCompanionBridge</RootNamespace>
    <AssemblyName>MSFSCompanionBridge</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude the stub source files from the main project compilation -->
  <ItemGroup>
    <Compile Remove="stubs/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
  </ItemGroup>

  <!--
    SimConnect reference:
    By default this points to the build-time stub in lib/.
    For production use on Windows, replace lib/Microsoft.FlightSimulator.SimConnect.dll
    with the real managed assembly from the MSFS SDK:
      C:\MSFS SDK\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll
  -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>lib/Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
